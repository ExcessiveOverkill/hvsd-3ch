	(text_box "Design is compatible with multiple IPM types\nCase: ONSEMI MODGC DIP39, 54.5x31.0\n\nIGBT variants:\nNFAM2065L4B, 20A 650v\nNFAM3065L4B, 30A 650v\nNFAM5065L4B, 50A 650v\nNFAM1512L7B, 15A 1200v\nNFAM2512L7B, 25A 1200v\nNFAM3512L7B, 35A 1200v\nT suffix includes internal thermistor\nL suffix is \"low-speed\" with slightly longer switching times\n\nSiC variants:\nNFAM5312SCBU, 40A 1200v\nNFAM3812SCBU, 50A 1200v\nNFAM2512SCBU, 70A 1200v\nT suffix includes internal thermistor\n\nNote:\nActual RMS current is significantly lower\nthan the peak current rating and depends on\nvoltage, PWM frequency, cooling, and other factors "
		(exclude_from_sim no)
		(at 33.02 30.48 0)
		(size 63.5 50.8)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d0c396eb-e8a4-4f07-80b4-5f3560bf752f")
	)
	(text "TEMP output is from LVIC\n1.5v @ 40C to 3.75v @ 130C\nlinear (low accuracy, +- 5C)"
		(exclude_from_sim no)
		(at 133.858 167.132 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "30ee7b2e-77d6-4bc7-bc95-7c2fe9d142d1")
	)
	(text "CFOD capacitance sets minimum\nFAULT pin pulse width (+- ~30%)\nt = 100,000 * capacitance\n(10nf ~= 1ms)\n"
		(exclude_from_sim no)
		(at 287.274 169.926 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "59fd0611-683f-45a9-812c-322721cfca6b")
	)
	(text "Shunts designed for NFAM2512SCBU, 70A\n\nresistance is 2.5mOhm, 2.5mV per amp\nmax cont. current with 1W resistors is ~28A\n\nactual max cont. motor current depends on\nPWM duty cycle, since the shunts are only powered\nwhen the low-side switch is on\n"
		(exclude_from_sim no)
		(at 345.44 40.894 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "758e7794-db7c-4f30-92ce-60cf5b49d640")
	)
	(text "THERM outputs are connected to an internal thermistor\n(only present on IPMs with a \"T\" suffix)\n47kOhm @ 25C to 1.406kOhm @ 125C\nB-constant: 4050K\n-40C - 125C\n"
		(exclude_from_sim no)
		(at 243.586 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "83eae965-7046-47f1-a07f-3156c69bb699")
	)
	(text "FAULT pin gets pulled down\nwhen IPM is in a fault state\n2mA max sink current"
		(exclude_from_sim no)
		(at 259.842 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a6607b87-159b-476c-98c1-a6a6302a0a42")
	)
	(text "PROTECT pin disables power\noutputs when above ~0.48v"
		(exclude_from_sim no)
		(at 377.698 155.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bc009487-776e-4fd6-8a76-012c3c326049")
	)
	(text "Phase PWM inputs are all active high\nNo built-in shoot-through protection\nRC filters are as specified in the IPM datasheet"
		(exclude_from_sim no)
		(at 48.514 159.766 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d62c8fb5-fa53-4c7f-b360-bc8bd1869317")
	)
