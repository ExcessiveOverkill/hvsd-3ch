         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NFAM2512SCBUT - Intelligent Power Module (IPM)  Inverter, 1200 V, 70 A</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NFAM2512SCBUT is a fullyâ€integrated inverter power module consisting of an independent High side gate driver, LVIC, six SiC MOSFET's and a temperature sensor (VTS or Thermistor), suitable for driving permanent magnet synchronous (PMSM) motors, brushless DC (BLDC) motors and AC asynchronous motors. The MOSFET's are configured in a threeâ€phase bridge with separate source connections for the lower legs for maximum flexibility in the choice of control algorithm.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreateDate>2025-07-31T13:30:32+02:00</xmp:CreateDate>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2025-07-31T13:31:39+02:00</xmp:ModifyDate>
         <xmp:MetadataDate>2025-07-31T13:31:39+02:00</xmp:MetadataDate>
